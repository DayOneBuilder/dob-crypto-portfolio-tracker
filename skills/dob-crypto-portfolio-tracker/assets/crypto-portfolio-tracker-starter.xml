 <Worksheet ss:Name="Holdings">
  <Table ss:ExpandedColumnCount="10" ss:ExpandedRowCount="2">
   <Row><Cell ss:StyleID="header"><Data ss:Type="String">wallet_id</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">chain</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">asset</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">quantity_now</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">current_price_usd</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">current_value_usd</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">cost_basis_usd</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">unrealized_pnl_usd</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">last_reconciled_utc</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">notes</Data></Cell></Row><Row><Cell><Data ss:Type="String">W001</Data></Cell><Cell><Data ss:Type="String">Ethereum</Data></Cell><Cell><Data ss:Type="String">ETH</Data></Cell><Cell ss:StyleID="decimal"><Data ss:Type="Number">1.25</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">2000.0</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=RC[-2]*RC[-1]"><Data ss:Type="Number">2500.0</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">2500.0</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=RC[-2]-RC[-1]"><Data ss:Type="Number">0.0</Data></Cell><Cell><Data ss:Type="String">2026-04-02 00:00</Data></Cell><Cell><Data ss:Type="String">Update quantity + price during reconciliation</Data></Cell></Row>
