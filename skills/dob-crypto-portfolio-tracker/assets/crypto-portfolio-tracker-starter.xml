 <Worksheet ss:Name="Dashboard">
  <Table ss:ExpandedColumnCount="3" ss:ExpandedRowCount="7">
   <Row><Cell ss:StyleID="header"><Data ss:Type="String">Metric</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">Value</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">Notes</Data></Cell></Row><Row><Cell ss:StyleID="subheader"><Data ss:Type="String">Total portfolio value</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=SUM(Holdings!R2C6:R200C6)"><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String">Sum of current holdings value</Data></Cell></Row><Row><Cell ss:StyleID="subheader"><Data ss:Type="String">Total cost basis</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=SUM(Holdings!R2C7:R200C7)"><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String">Sum of tracked cost basis for open holdings</Data></Cell></Row><Row><Cell ss:StyleID="subheader"><Data ss:Type="String">Unrealized P&amp;L</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=SUM(Holdings!R2C8:R200C8)"><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String">Current value minus cost basis on open holdings</Data></Cell></Row><Row><Cell ss:StyleID="subheader"><Data ss:Type="String">Realized P&amp;L</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=SUM(Transactions!R2C19:R500C19)"><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String">Manual or imported realized exits</Data></Cell></Row><Row><Cell ss:StyleID="subheader"><Data ss:Type="String">Total fees</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=SUM(Transactions!R2C13:R500C13)"><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String">Gas + exchange fees recorded in Transactions</Data></Cell></Row><Row><Cell ss:StyleID="subheader"><Data ss:Type="String">Active wallets</Data></Cell><Cell ss:StyleID="integer" ss:Formula="=COUNTA(Wallets!R2C1:R200C1)"><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String">Wallet count excluding header</Data></Cell></Row>
