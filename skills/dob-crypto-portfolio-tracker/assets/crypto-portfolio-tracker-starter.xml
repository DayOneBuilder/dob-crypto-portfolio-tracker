   <Row><Cell ss:StyleID="header"><Data ss:Type="String">date_time_utc</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">wallet_id</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">chain</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">event_type</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">asset_in</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">qty_in</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">asset_out</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">qty_out</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">usd_value</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">cost_basis_usd</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">fee_asset</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">fee_qty</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">fee_usd</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">protocol_or_counterparty</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">tx_hash</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">linked_transfer_id</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">source_of_truth</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">notes</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">realized_pnl_usd</Data></Cell></Row><Row><Cell><Data ss:Type="String">2026-04-02 00:00</Data></Cell><Cell><Data ss:Type="String">W001</Data></Cell><Cell><Data ss:Type="String">Ethereum</Data></Cell><Cell><Data ss:Type="String">buy</Data></Cell><Cell><Data ss:Type="String">ETH</Data></Cell><Cell ss:StyleID="decimal"><Data ss:Type="Number">1.25</Data></Cell><Cell><Data ss:Type="String">USDC</Data></Cell><Cell ss:StyleID="decimal"><Data ss:Type="Number">2500.0</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">2500.0</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">2500.0</Data></Cell><Cell><Dat