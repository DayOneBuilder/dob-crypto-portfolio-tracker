 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
    <Alignment ss:Vertical="Bottom"/>
    <Borders/>
    <Font ss:FontName="Calibri" ss:Size="11"/>
    <Interior/>
    <NumberFormat/>
    <Protection/>
  </Style>
  <Style ss:ID="title">
    <Font ss:FontName="Calibri" ss:Size="14" ss:Bold="1"/>
  </Style>
  <Style ss:ID="header">
    <Font ss:FontName="Calibri" ss:Bold="1" ss:Color="#FFFFFF"/>
    <Interior ss:Color="#17313A" ss:Pattern="Solid"/>
    <Alignment ss:Vertical="Center" ss:WrapText="1"/>
  </Style>
  <Style ss:ID="subheader">
    <Font ss:FontName="Calibri" ss:Bold="1"/>
    <Interior ss:Color="#EAF6F2" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="note">
    <Alignment ss:Vertical="Top" ss:WrapText="1"/>
  </Style>
  <Style ss:ID="currency">
    <NumberFormat ss:Format="$#,##0.00;[Red]-$#,##0.00"/>
  </Style>
  <Style ss:ID="integer">
    <NumberFormat ss:Format="0"/>
  </Style>
  <Style ss:ID="decimal">
    <NumberFormat ss:Format="0.00000000"/>
  </Style>
  <Style ss:ID="date">
    <NumberFormat ss:Format="yyyy-mm-dd\ hh:mm"/>
  </Style>
</Styles>
 <Worksheet ss:Name="Instructions">
  <Table ss:ExpandedColumnCount="5" ss:ExpandedRowCount="9">
   <Column ss:Width="220"/>
   <Column ss:Width="220"/>
   <Column ss:Width="220"/>
   <Column ss:Width="220"/>
   <Column ss:Width="220"/>
   <Row ss:Height="24"><Cell ss:StyleID="title" ss:MergeAcross="4"><Data ss:Type="String">Crypto Portfolio Tracker Starter</Data></Cell></Row><Row><Cell ss:StyleID="note" ss:MergeAcross="4"><Data ss:Type="String">Use this workbook to track wallets, transfers, P&amp;L, staking rewards, airdrops, and DeFi positions without breaking cost basis.</Data></Cell></Row><Row/><Row><Cell ss:StyleID="note" ss:MergeAcross="4"><Data ss:Type="String">1) Add each wallet or exchange account in the Wallets tab.</Data></Cell></Row><Row><Cell ss:StyleID="note" ss:MergeAcross="4"><Data ss:Type="String">2) Log every meaningful event in Transactions. Use event_type consistently.</Data></Cell></Row><Row><Cell ss:StyleID="note" ss:MergeAcross="4"><Data ss:Type="String">3) Link internal transfers with the same transfer ID so they stay neutral.</Data></Cell></Row><Row><Cell ss:StyleID="note" ss:MergeAcross="4"><Data ss:Type="String">4) Update the Holdings tab with current balances and prices when you reconcile.</Data></Cell></Row><Row><Cell ss:StyleID="note" ss:MergeAcross="4"><Data ss:Type="String">5) Dashboard totals update from Holdings + Transactions inputs.</Data></Cell></Row><Row><Cell ss:StyleID="note" ss:MergeAcross="4"><Data ss:Type="String">6) Suggested event_type values: buy, sell, transfer_in, transfer_out, bridge, stake, unstake, reward, airdrop, LP_deposit, LP_withdraw, borrow, repay.</Data></Cell></Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="Wallets">
  <Table ss:ExpandedColumnCount="7" ss:ExpandedRowCount="2">
   <Row><Cell ss:StyleID="header"><Data ss:Type="String">wallet_id</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">wallet_label</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">chain</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">wallet_type</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">status</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">address_or_nickname</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">notes</Data></Cell></Row><Row><Cell><Data ss:Type="String">W001</Data></Cell><Cell><Data ss:Type="String">Main EVM Wallet</Data></Cell><Cell><Data ss:Type="String">Ethereum</Data></Cell><Cell><Data ss:Type="String">hot_wallet</Data></Cell><Cell><Data ss:Type="String">active</Data></Cell><Cell><Data ss:Type="String">0x...abcd</Data></Cell><Cell><Data ss:Type="String">Primary trading wallet</Data></Cell></Row>
  </Table>
 </Worksheet>
